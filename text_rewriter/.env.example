# Kopieer dit bestand naar text_rewriter/.env en vul je eigen waarden in.
# Een gratis API key maak je aan op https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optioneel: standaardmodel. Laat leeg om de ingebouwde default te gebruiken.
# Voorbeelden van gratis modellen:
#   meta-llama/llama-3.3-70b-instruct:free
#   deepseek/deepseek-chat-v3.1:free
#   google/gemini-2.0-flash-exp:free
#   qwen/qwen-2.5-72b-instruct:free
#   openrouter/free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
