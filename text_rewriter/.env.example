# Kopieer dit bestand naar text_rewriter/.env en vul je eigen waarden in.
# Een gratis API key maak je aan op https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optioneel: standaardmodel. Laat leeg om de ingebouwde default te gebruiken.
# Voorbeelden van gratis modellen (zie ook https://openrouter.ai/models?free=true):
#   openai/gpt-oss-120b:free          (default, doorgaans goed beschikbaar)
#   openai/gpt-oss-20b:free           (kleiner, sneller)
#   meta-llama/llama-3.3-70b-instruct:free
#   qwen/qwen3-next-80b-a3b-instruct:free
#   z-ai/glm-4.5-air:free
#   nousresearch/hermes-3-llama-3.1-405b:free
OPENROUTER_MODEL=openai/gpt-oss-120b:free
