name: Build Windows executable

on:
  push:
    branches: [main]
    tags: ["v*"]
  pull_request:
    branches: [main]
  workflow_dispatch: {}

permissions:
  contents: write

jobs:
  build:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install pyinstaller

      - name: Build executable
        run: pyinstaller --clean --noconfirm Word-instructie-helper.spec

      - name: Smoke-test executable (HTTP health check)
        shell: pwsh
        run: |
          $exe = "dist\Word-instructie-helper.exe"
          if (-not (Test-Path $exe)) { throw "Executable not produced at $exe" }
          $proc = Start-Process -FilePath $exe `
            -ArgumentList "--host","127.0.0.1","--port","8766","--no-browser" `
            -PassThru -WindowStyle Hidden
          try {
            $ok = $false
            for ($i = 0; $i -lt 30; $i++) {
              Start-Sleep -Seconds 1
              try {
                $r = Invoke-WebRequest -UseBasicParsing -Uri "http://127.0.0.1:8766/api/health" -TimeoutSec 2
                if ($r.StatusCode -eq 200) { $ok = $true; break }
              } catch { }
            }
            if (-not $ok) { throw "Executable failed health check" }
            Write-Output "Health check OK: $($r.Content)"
          } finally {
            if (-not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
          }

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: Word-instructie-helper-windows
          path: dist/Word-instructie-helper.exe
          if-no-files-found: error
          retention-days: 30

      - name: Attach to GitHub release (when tagging)
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: dist/Word-instructie-helper.exe
